{
  "name": "thinkframe",
  "productName": "ThinkFrame",
  "version": "0.3.0",
  "description": "생각을 실행 가능한 형태로 발전시키는 로컬 중심 AI 사고 보조 메모장",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leondic1976/Deploy-Think-Frame-Concept-Edit-TFCedit.git"
  },
  "homepage": "https://github.com/leondic1976/Deploy-Think-Frame-Concept-Edit-TFCedit#readme",
  "bugs": {
    "url": "https://github.com/leondic1976/Deploy-Think-Frame-Concept-Edit-TFCedit/issues"
  },
  "main": ".vite/build/main.js",
  "author": "ThinkFrame",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:windows": "electron-forge make --platform=win32 --arch=x64",
    "make:mac:x64": "electron-forge make --platform=darwin --arch=x64",
    "make:mac:arm64": "electron-forge make --platform=darwin --arch=arm64",
    "make:linux": "electron-forge make --platform=linux --arch=x64",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "site:check": "node --check site/script.js",
    "smoke:app": "node scripts/smoke-app.mjs",
    "smoke:site": "node scripts/smoke-site.mjs",
    "check": "npm run lint && npm run typecheck && npm run site:check && npm test",
    "icons": "node scripts/generate-icons.mjs",
    "artifacts": "node scripts/collect-artifacts.mjs",
    "version:check": "node scripts/check-version.mjs",
    "preversion": "npm run check",
    "version": "npm run version:check",
    "version:patch": "npm version patch -m \"release: v%s\"",
    "version:minor": "npm version minor -m \"release: v%s\"",
    "version:major": "npm version major -m \"release: v%s\""
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
